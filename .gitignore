## Core latex/pdflatex auxiliary files - ignore these during version control:
*.aux
*.lof
*.log
*.lot
*.fls
*.out
*.toc
*.fmt
*.fot
*.cb
*.cb2
.*.lb

## Intermediate documents - also not needed in version control:
*.dvi
*.xdv
*-converted-to.*

## Bibliography auxiliary files (bibtex/biblatex/biber) - generated files:
*.bbl
*.bcf
*.blg
*-blx.aux
*-blx.bib
*.run.xml

## Build tool auxiliary files - temporary build artifacts:
*.fdb_latexmk
*.synctex
*.synctex(busy)
*.synctex.gz
*.synctex.gz(busy)
*.pdfsync

## Other generated files - like the PDF itself:
*.pdf

## Temporary files - editor backups and such:
*~

# LaTeX temporary files
*.aux
*.bcf
*.log
*.out
*.toc
*.blg
*.bbl
*.fls
*.fdb_latexmk
*.synctex.gz
*.pdfsync

# Build directory
build/

# System files
.DS_Store
Thumbs.db

# Editor directories and files
.idea/
.vscode/
*.swp
*.swo

# Backup files
*.bak
*.backup
*~

# Obsidian
.obsidian/

# Temporary files
*.tmp
*.temp